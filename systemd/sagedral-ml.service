[Unit]
Description=SAGEDRAL-ML Network Intrusion Detection and Prevention System
Documentation=https://github.com/sagedral02/SAGEDRAL-ML-Smart-Adaptive-Guardian-for-Detection-Response-and-Adaptive-Learning-ML
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
WorkingDirectory=/var/lib/sagedral-ml
UMask=0022
Environment=HOME=/root
Environment=SAGEDRAL_CONFIG_PATH=/etc/sagedral/config.toml
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/local/bin/sagedral-ml config validate
ExecStart=/usr/local/bin/sagedral-ml start --no-daemon
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
WatchdogSec=60
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sagedral-ml

[Install]
WantedBy=multi-user.target
